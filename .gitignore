#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
supabase/functions/.env*
!supabase/functions/.env.example
/supabase/.temp/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/artifacts/

# Local agent and MCP runtime state
.fry/
.omc/
/.env.notion-mcp

# Build-time configuration overrides (see tool/dart-defines.example.json)
/dart-defines.json

# Firebase console downloads this for the native Android SDK path, which this
# app does not use (see docs/android-distribution.md). Keeping it out of the
# repo avoids implying the app talks to Firebase.
android/app/google-services.json
