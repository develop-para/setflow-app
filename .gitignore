# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
supabase/functions/.env*
!supabase/functions/.env.example
/supabase/.temp/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/artifacts/

# Local agent and MCP runtime state
.fry/
.omc/
/.env.notion-mcp

# Build-time configuration overrides (see tool/dart-defines.example.json)
/dart-defines.json

# android/app/google-services.json은 이제 저장소에 들어간다.
# 예전 규칙은 "이 앱은 네이티브 Firebase SDK를 쓰지 않는다"가 근거였는데,
# 푸시 알림(firebase_messaging)이 들어오면서 그 전제가 깨졌다 — google-services
# Gradle 플러그인이 빌드 타임에 이 파일을 요구하므로 없으면 릴리스 빌드가 죽는다.
# 시크릿은 들어 있지 않다(OAuth 클라이언트 시크릿·서비스 계정 키 없음). 안드로이드
# API 키는 패키지명 + SHA 지문으로 제한되는 식별자이고, 구글도 커밋을 권한다.
# 진짜 시크릿인 서명 키(key.properties·*.jks)와 FCM 서비스 계정은 계속 제외한다.
